{
  "name": "kenchiku-sekisan",
  "version": "0.1.77",
  "description": "建築積算システム（完全オフラインのWindowsデスクトップアプリ）",
  "main": "./out/main/index.js",
  "author": "有限会社ビルズワーク",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 --build-from-source",
    "rebuild:node": "npm rebuild better-sqlite3",
    "package:win": "npm run build && node scripts/prepare-win-native.mjs && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3": "11.6.0",
    "drizzle-orm": "0.36.4",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "3.0.1",
    "@electron-toolkit/tsconfig": "1.0.1",
    "@electron-toolkit/utils": "3.0.0",
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "7.6.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "drizzle-kit": "0.28.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
